# =====================================================================
# Rabbora Living — ROOT .gitignore   (C:\Users\DELL\Desktop\website -3\.gitignore)
# Only secrets, dependencies, logs, OS/editor junk and temporary files
# are ignored. All website, admin and backend source code, SQL files
# (backend/database/), package.json and package-lock.json are committed.
# =====================================================================

# Dependencies
node_modules/

# Environment variables (secrets: database password, session secret, Stripe keys)
.env
.env.*
backend/.env
# ...but the empty template with variable names only is committed
!.env.example
!backend/.env.example

# Logs
*.log
npm-debug.log*
npm-debug.log
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor files
.vscode/

# Temporary files
*.tmp
*.temp