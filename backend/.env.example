# Rabbora Living — backend environment template (names and placeholders only).
# Copy this file to backend/.env on your own machine and fill in real values there.
# backend/.env must never be committed to GitHub (it is in .gitignore).
#
# IMPORTANT: backend/.env is loaded with process.loadEnvFile(), and that never
# overwrites a variable that is already set in the environment. On Hostinger,
# any SMTP_* or SITE_URL value set in the hosting panel WINS over this file.
# Check the panel and remove stale values (for example SMTP_HOST=localhost or
# SMTP_PORT=1025, which come from a local mail catcher and are refused in
# production).

NODE_ENV=production

# Public website address. Password reset links are built from this value.
SITE_URL=https://rabbora.co.uk

# Outgoing email (password reset). Hostinger mail server:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# The full mailbox address that has the password below.
SMTP_USER=your-mailbox@yourdomain.co.uk
SMTP_PASSWORD=replace-with-the-mailbox-password
# Sender shown to customers. Must be a mailbox on the domain that the SMTP login can send as.
EMAIL_FROM=Rabbora Living <your-mailbox@yourdomain.co.uk>


# Password reset link lifetime in minutes (10 to 120; default 30).
PASSWORD_RESET_EXPIRY_MINUTES=30

# ---- Stripe (online card payments). Names and placeholders only. ----
# Test keys (sk_test_ / pk_test_) for testing. In production the LIVE keys
# are used; a test key in production switches online payment OFF.
# Live mode is refused unless STRIPE_ALLOW_LIVE=true is set on purpose.
STRIPE_SECRET_KEY=<value>
STRIPE_PUBLISHABLE_KEY=<value>
# whsec_ of the webhook endpoint for this mode (test and live have different ones).
STRIPE_WEBHOOK_SECRET=<value>
# Set to true ONLY when the client has approved Live Mode.
STRIPE_ALLOW_LIVE=<value>
